root = true

# Keep all source files UTF-8 so accented Spanish text (á é í ó ú ñ ·) is
# never re-encoded into "?" by an editor saving as ANSI/cp1252.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
trim_trailing_whitespace = false
